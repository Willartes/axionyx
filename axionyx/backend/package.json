{
  "name": "axionyx-backend",
  "version": "1.10.1",
  "private": true,
  "description": "AXIONYX ERP — API REST (Node.js + TypeScript + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "seed:demo": "node dist/db/seed.js --demo",
    "reset-password": "node dist/db/reset-password.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 dist/test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~6.0.2"
  }
}
