# Copie para .env e ajuste. NUNCA versione o arquivo .env.
PORT=3000
DATABASE_URL=postgres://axionyx:troque-esta-senha@localhost:5432/axionyx
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origem do frontend permitida (CORS). Em produção use o domínio real.
CORS_ORIGIN=http://localhost:4200
# Duração da sessão (horas)
SESSION_HOURS=10
# Pasta com o build do Angular para servir pelo backend (opcional)
STATIC_DIR=
# Chave para cifrar credenciais gravadas no banco (token do WhatsApp por empresa). Recomendado; se vazia, deriva do JWT_SECRET.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETS_KEY=
# Executa o worker de integrações (outbox) neste processo
RUN_WORKER=true

# ---- Integrações externas (deixe vazio enquanto não houver contrato/credenciais) ----
# Fiscal: provedor de NF-e/NFC-e (ex.: "http" para um provedor REST genérico). Vazio = pendente de configuração.
FISCAL_PROVIDER=
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=
# WhatsApp: o normal é cada empresa cadastrar o próprio número na tela Integrações › WhatsApp.
# As variáveis abaixo são um número GLOBAL de reserva (opcional).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
# E-commerce (adaptador REST genérico)
ECOMMERCE_API_URL=
ECOMMERCE_API_TOKEN=
# Segredo HMAC-SHA256 para validar o webhook de pedidos (cabeçalho X-Signature)
ECOMMERCE_WEBHOOK_SECRET=
# Logística (adaptador REST genérico de cotação/etiquetas)
LOGISTICS_API_URL=
LOGISTICS_API_TOKEN=
APP_TZ=America/Sao_Paulo

# ---- Cobrança das assinaturas AXIONYX (Mercado Pago) — veja docs/INTEGRACOES.md, seção 7 ----
# Access Token da aplicação (Suas integrações › Credenciais). Comece pelo de teste (TEST-...).
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Webhooks › Configurar notificações › revelar chave)
MP_WEBHOOK_SECRET=
# Endereço público do sistema, sem barra no final (links de retorno e URL do webhook)
APP_PUBLIC_URL=
# Opcional: rejeita notificações com mais de N segundos (0 = desligado)
MP_WEBHOOK_MAX_AGE_SEC=0
# Consulta pública da situação do CNPJ na auditoria de propostas (brasilapi | off)
CNPJ_LOOKUP=brasilapi

# ---- Testes automatizados (banco dedicado; o esquema é recriado a cada execução) ----
# TEST_DATABASE_URL=postgres://axionyx:troque-esta-senha@localhost:5432/axionyx_test
# ---- Carga inicial (npm run seed) ----
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# COMPANY_NAME=
# COMPANY_CNPJ=
# DEMO_PASSWORD=   (npm run seed:demo — empresa fictícia de demonstração)
